{
    "name": "geeklab/arraytranslation",
    "description": "Convert array to another data format or convert a data format to an array.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "ellisgl",
            "email": "example@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "geeklab/toolbox": "^3.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "spatie/phpunit-snapshot-assertions": "^4.2",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "GeekLab\\": "src"
        }
    },
    "suggest": {
        "ext-yaml": "Needed for YAML translation (pecl install yaml)"
    },
    "scripts": {
        "test": "codecept run unit",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs src --standard=PSR12 -n"
    }
}
